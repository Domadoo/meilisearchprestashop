{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block pageTitle %}{{ settingsTitle }}{% endblock %}

{% block content %}
<div class="nav-tabs-custom mb-3">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item">
      <a class="nav-link active" href="{{ path('admin_meilisearch_configuration_index') }}">{{ settingsTitle }}</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="{{ path('admin_meilisearch_index_index') }}">{{ indexationTitle }}</a>
    </li>
  </ul>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-header-title">
      <i class="material-icons">settings</i>
      {{ settingsTitle }}
    </h3>
  </div>
  <div class="card-body">
    {% for message in app.flashes('success') %}
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        {{ message }}
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
      </div>
    {% endfor %}

    <form id="meilisearch-configuration-form" method="POST" action="{{ path('admin_meilisearch_configuration_index') }}">
      <input type="hidden" name="submitMeilisearchprestashopSettings" value="1">
      <input type="hidden" name="_token" value="{{ csrf_token('save_meilisearch_config') }}">

      <div class="form-group row">
        <label class="col-sm-3 col-form-label" for="MEILISEARCHPRESTASHOP_URL">{{ urlLabel }}</label>
        <div class="col-sm-9">
          <input type="text" class="form-control" id="MEILISEARCHPRESTASHOP_URL" name="MEILISEARCHPRESTASHOP_URL" value="{{ config['MEILISEARCHPRESTASHOP_URL'] }}">
          <small class="form-text text-muted">{{ urlHelp }}</small>
        </div>
      </div>

      <div class="form-group row">
        <label class="col-sm-3 col-form-label" for="MEILISEARCHPRESTASHOP_KEY">{{ apiKeyLabel }}</label>
        <div class="col-sm-9">
          <input type="password" class="form-control" id="MEILISEARCHPRESTASHOP_KEY" name="MEILISEARCHPRESTASHOP_KEY" value="" autocomplete="new-password" placeholder="Leave empty to keep current key">
        </div>
      </div>

      <div class="form-group row">
        <label class="col-sm-3 col-form-label" for="MEILISEARCHPRESTASHOP_PREFIX">{{ prefixLabel }}</label>
        <div class="col-sm-4">
          <input type="text" class="form-control" id="MEILISEARCHPRESTASHOP_PREFIX" name="MEILISEARCHPRESTASHOP_PREFIX" value="{{ config['MEILISEARCHPRESTASHOP_PREFIX'] }}">
          <small class="form-text text-muted">{{ prefixHelp }}</small>
        </div>
      </div>

      <div class="form-group row">
        <label class="col-sm-3 col-form-label" for="MEILISEARCHPRESTASHOP_TOKEN_CRON">{{ cronTokenLabel }}</label>
        <div class="col-sm-4">
          <input type="password" class="form-control" id="MEILISEARCHPRESTASHOP_TOKEN_CRON" name="MEILISEARCHPRESTASHOP_TOKEN_CRON" value="" autocomplete="new-password" placeholder="Leave empty to keep current token">
          <small class="form-text text-muted">{{ cronTokenHelp }} {{ cronTokenExample }}</small>
        </div>
      </div>

      <div class="card-footer">
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">
            <i class="material-icons">save</i>
            {{ saveLabel }}
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
{% endblock %}
