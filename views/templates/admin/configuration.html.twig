{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block pageTitle %}Settings{% endblock %}

{% block content %}
<div class="nav-tabs-custom mb-3">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item">
      <a class="nav-link active" href="{{ path('admin_meilisearch_configuration_index') }}">Settings</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="{{ path('admin_meilisearch_index_index') }}">Indexation</a>
    </li>
  </ul>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-header-title">
      <i class="material-icons">settings</i>
      Settings
    </h3>
  </div>
  <div class="card-body">
    {% for message in app.flashes('success') %}
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        {{ message }}
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
      </div>
    {% endfor %}

    <form id="meilisearch-configuration-form" method="POST" action="{{ path('admin_meilisearch_configuration_index') }}">
      <input type="hidden" name="submitMeilisearchprestashopSettings" value="1">

      <div class="form-group row">
        <label class="col-sm-3 col-form-label" for="MEILISEARCHPRESTASHOP_URL">URL</label>
        <div class="col-sm-9">
          <input type="text" class="form-control" id="MEILISEARCHPRESTASHOP_URL" name="MEILISEARCHPRESTASHOP_URL" value="{{ config['MEILISEARCHPRESTASHOP_URL'] }}">
          <small class="form-text text-muted">Meilisearch instance URL (with trailing /)</small>
        </div>
      </div>

      <div class="form-group row">
        <label class="col-sm-3 col-form-label" for="MEILISEARCHPRESTASHOP_KEY">API Key</label>
        <div class="col-sm-9">
          <input type="text" class="form-control" id="MEILISEARCHPRESTASHOP_KEY" name="MEILISEARCHPRESTASHOP_KEY" value="{{ config['MEILISEARCHPRESTASHOP_KEY'] }}">
        </div>
      </div>

      <div class="form-group row">
        <label class="col-sm-3 col-form-label" for="MEILISEARCHPRESTASHOP_PREFIX">Index prefix</label>
        <div class="col-sm-4">
          <input type="text" class="form-control" id="MEILISEARCHPRESTASHOP_PREFIX" name="MEILISEARCHPRESTASHOP_PREFIX" value="{{ config['MEILISEARCHPRESTASHOP_PREFIX'] }}">
          <small class="form-text text-muted">Index prefix (e.g. shop1_)</small>
        </div>
      </div>

      <div class="form-group row">
        <label class="col-sm-3 col-form-label" for="MEILISEARCHPRESTASHOP_TOKEN_CRON">Cron token</label>
        <div class="col-sm-4">
          <input type="text" class="form-control" id="MEILISEARCHPRESTASHOP_TOKEN_CRON" name="MEILISEARCHPRESTASHOP_TOKEN_CRON" value="{{ config['MEILISEARCHPRESTASHOP_TOKEN_CRON'] }}">
          <small class="form-text text-muted">Enter a private key, for example : {{ cronTokenExample }}</small>
        </div>
      </div>

      <div class="card-footer">
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">
            <i class="material-icons">save</i>
            Save
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
{% endblock %}
