{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block pageTitle %}{{ indexationTitle }}{% endblock %}

{% block content %}
<div class="nav-tabs-custom mb-3">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item">
      <a class="nav-link" href="{{ path('admin_meilisearch_configuration_index') }}">{{ settingsTitle }}</a>
    </li>
    <li class="nav-item">
      <a class="nav-link active" href="{{ path('admin_meilisearch_index_index') }}">{{ indexationTitle }}</a>
    </li>
  </ul>
</div>

<div class="row">
  <div class="card col">
    <div class="card-header">
      <h3>{{ indexingMeilisearchText }}</h3>
    </div>
    <div class="card-body">
      <button type="button" class="btn btn-primary" data-ms-index-action="all">
        {{ indexingMeillisearchProductsText }}
      </button>
      <hr>
      <div class="form-inline mt-2">
        <select class="form-control form-control-sm mr-2" id="ms-lang-select">
          <option value="">{{ chooseLanguage }}</option>
          {% for lang in languages %}
            <option value="{{ lang.iso_code }}">{{ lang.name }} ({{ lang.iso_code }})</option>
          {% endfor %}
        </select>
        <button type="button" class="btn btn-sm btn-outline-primary" data-ms-index-action="language">{{ reindexLanguageBtn }}</button>
      </div>
    </div>
  </div>
</div>

{# Progression de la réindexation AJAX : masquée tant qu'aucun run n'est en cours #}
<div class="row" id="ms-progress-row" style="display:none">
  <div class="card col">
    <div class="card-header">
      <h3>{{ progressTitle }}</h3>
    </div>
    <div class="card-body">
      <div class="d-flex justify-content-between mb-1">
        <strong id="ms-progress-label"></strong>
        <span id="ms-progress-counter" class="text-muted"></span>
      </div>
      <div class="progress mb-2" style="height:20px">
        <div id="ms-progress-bar"
             class="progress-bar progress-bar-striped"
             role="progressbar"
             style="width:0%"
             aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0 %</div>
      </div>
      <p id="ms-progress-phase" class="text-muted mb-2"></p>
      <div id="ms-progress-alert" class="alert" style="display:none"></div>
      <ul id="ms-progress-log" class="list-unstyled small mb-2" style="max-height:160px;overflow-y:auto"></ul>
      <button type="button" class="btn btn-sm btn-outline-danger" data-ms-index-action="abort">{{ btnCancelIndexation }}</button>
    </div>
  </div>
</div>

<div class="row">
  <div class="card col">
    <div class="card-header">
      <h3>Index Meilisearch</h3>
    </div>
    <div class="card-body">
      {% if indexes is empty %}
        <p class="text-muted">{{ noIndexFound }}</p>
      {% else %}
        {# Formulaire suppression individuelle #}
        <form id="single-delete-form" method="POST" action="" style="display:none">
          <input type="hidden" name="_token" id="single-delete-token" value="">
        </form>

        {# Formulaire flush individuel #}
        <form id="single-flush-form" method="POST" action="" style="display:none">
          <input type="hidden" name="_token" id="single-flush-token" value="">
        </form>

        {# Formulaire bulk delete #}
        <form id="bulk-delete-form" method="POST" action="{{ path('admin_meilisearch_index_bulk_delete') }}" style="display:none">
          <input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_indexes') }}">
        </form>

        {# Formulaire bulk flush #}
        <form id="bulk-flush-form" method="POST" action="{{ path('admin_meilisearch_index_bulk_flush') }}" style="display:none">
          <input type="hidden" name="_token" value="{{ csrf_token('bulk_flush_indexes') }}">
        </form>

        <div class="d-flex align-items-center mb-2 px-1">
          <select class="form-control form-control-sm w-auto mr-2" id="bulk-action-select">
            <option value="">{{ bulkActionsPlaceholder }}</option>
            <option value="reindex">{{ bulkReindexLabel }}</option>
            <option value="flush">{{ bulkFlushLabel }}</option>
            <option value="delete">{{ bulkDeleteLabel }}</option>
          </select>
          <button type="button" class="btn btn-sm btn-outline-danger" data-ms-index-action="bulk">{{ applyLabel }}</button>
        </div>

        <table class="table mb-0">
          <thead>
            <tr>
              <th style="width:40px"><input type="checkbox" id="select-all"></th>
              <th>UID</th>
              <th>Documents</th>
              <th>{{ colCreatedAt }}</th>
              <th>{{ colUpdatedAt }}</th>
              <th>{{ colActions }}</th>
            </tr>
          </thead>
          <tbody>
            {% for index in indexes %}
            <tr>
              <td><input type="checkbox" name="uids[]" value="{{ index.uid }}" class="row-checkbox" data-iso="{{ index.iso_code }}"></td>
              <td>{{ index.uid }}</td>
              <td>{{ index.numberOfDocuments ?? '—' }}</td>
              <td>{{ index.createdAt ? index.createdAt|slice(0, 19)|replace({'T': ' '}) : '—' }}</td>
              <td>{{ index.updatedAt ? index.updatedAt|slice(0, 19)|replace({'T': ' '}) : '—' }}</td>
              <td>
                <a href="{{ path('admin_meilisearch_index_settings', {uid: index.uid}) }}" class="btn btn-sm btn-outline-secondary">{{ btnEdit }}</a>
                {# Réindexable seulement si l'index correspond à une langue de la boutique #}
                {% if index.iso_code %}
                <button type="button" class="btn btn-sm btn-outline-primary"
                  data-ms-index-action="reindex"
                  data-iso="{{ index.iso_code }}"
                  data-uid="{{ index.uid }}">{{ btnReindex }}</button>
                {% endif %}
                <button type="button" class="btn btn-sm btn-outline-warning"
                  data-ms-index-action="flush"
                  data-action="{{ path('admin_meilisearch_index_flush', {uid: index.uid}) }}"
                  data-token="{{ csrf_token('flush_index_' ~ index.uid) }}"
                  data-uid="{{ index.uid }}">{{ btnFlush }}</button>
                <button type="button" class="btn btn-sm btn-outline-danger"
                  data-ms-index-action="delete"
                  data-action="{{ path('admin_meilisearch_index_delete', {uid: index.uid}) }}"
                  data-token="{{ csrf_token('delete_index_' ~ index.uid) }}"
                  data-uid="{{ index.uid }}">{{ btnDelete }}</button>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  </div>
</div>

<script>
  window.msIndexAjax = {
    endpoints: {
      start: {{ path('admin_meilisearch_index_ajax_start')|json_encode|raw }},
      step: {{ path('admin_meilisearch_index_ajax_step')|json_encode|raw }},
      status: {{ path('admin_meilisearch_index_ajax_status')|json_encode|raw }},
      abort: {{ path('admin_meilisearch_index_ajax_abort')|json_encode|raw }}
    },
    token: {{ csrf_token('meilisearch_index_ajax')|json_encode|raw }},
    i18n: {
      confirmReindex: {{ confirmReindexMsg|json_encode|raw }},
      confirmFlush: {{ confirmFlushMsg|json_encode|raw }},
      confirmDelete: {{ confirmDeleteMsg|json_encode|raw }},
      confirmBulkReindex: {{ confirmBulkReindex|json_encode|raw }},
      confirmBulkFlush: {{ confirmBulkFlush|json_encode|raw }},
      confirmBulkDelete: {{ confirmBulkDelete|json_encode|raw }},
      pleaseChooseLang: {{ pleaseChooseLang|json_encode|raw }},
      confirmReindexLang: {{ confirmReindexLang|json_encode|raw }},
      confirmCancelIndexation: {{ confirmCancelIndexation|json_encode|raw }},
      indexationDone: {{ indexationDone|json_encode|raw }},
      indexationDoneErrors: {{ indexationDoneErrors|json_encode|raw }},
      indexationResumed: {{ indexationResumed|json_encode|raw }},
      indexationNetworkError: {{ indexationNetworkError|json_encode|raw }},
      productsProgress: {{ productsProgress|json_encode|raw }},
      languageProgress: {{ languageProgress|json_encode|raw }}
    }
  };
</script>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('../modules/meilisearchprestashop/views/js/admin/meilisearch_index.js') }}"></script>
{% endblock %}
