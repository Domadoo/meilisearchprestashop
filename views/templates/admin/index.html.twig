{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block pageTitle %}{{ indexationTitle }}{% endblock %}

{% block content %}
<script>
  var msI18n = {
    confirmReindex: {{ confirmReindexMsg|json_encode|raw }},
    confirmFlush: {{ confirmFlushMsg|json_encode|raw }},
    confirmDelete: {{ confirmDeleteMsg|json_encode|raw }},
    confirmBulkReindex: {{ confirmBulkReindex|json_encode|raw }},
    confirmBulkFlush: {{ confirmBulkFlush|json_encode|raw }},
    confirmBulkDelete: {{ confirmBulkDelete|json_encode|raw }},
    pleaseChooseLang: {{ pleaseChooseLang|json_encode|raw }},
    confirmReindexLang: {{ confirmReindexLang|json_encode|raw }}
  };
</script>

<div class="nav-tabs-custom mb-3">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item">
      <a class="nav-link" href="{{ path('admin_meilisearch_configuration_index') }}">{{ settingsTitle }}</a>
    </li>
    <li class="nav-item">
      <a class="nav-link active" href="{{ path('admin_meilisearch_index_index') }}">{{ indexationTitle }}</a>
    </li>
  </ul>
</div>

<div class="row">
  <div class="card col">
    <div class="card-header">
      <h3>{{ indexingMeilisearchText }}</h3>
    </div>
    <div class="card-body">
      <form method="POST" action="{{ path('admin_meilisearch_index_products') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('index_products') }}">
        <button type="submit" class="btn btn-primary">
          {{ indexingMeillisearchProductsText }}
        </button>
      </form>
      <hr>
      <form method="POST" action="" id="reindex-lang-form" class="form-inline mt-2">
        <input type="hidden" name="_token" id="reindex-lang-token" value="">
        <select name="_lang" class="form-control form-control-sm mr-2" id="reindex-lang-select">
          <option value="">{{ chooseLanguage }}</option>
          {% for lang in languages %}
            {% set uid = lang.iso_code %}
            <option
              value="{{ uid }}"
              data-action="{{ path('admin_meilisearch_index_reindex_language', {uid: uid}) }}"
              data-token="{{ csrf_token('reindex_index_' ~ uid) }}"
            >{{ lang.name }} ({{ lang.iso_code }})</option>
          {% endfor %}
        </select>
        <button type="button" class="btn btn-sm btn-outline-primary" id="reindex-lang-btn">{{ reindexLanguageBtn }}</button>
      </form>
    </div>
  </div>
</div>

<div class="row">
  <div class="card col">
    <div class="card-header">
      <h3>Index Meilisearch</h3>
    </div>
    <div class="card-body">
      {% if indexes is empty %}
        <p class="text-muted">{{ noIndexFound }}</p>
      {% else %}
        {# Formulaire suppression individuelle #}
        <form id="single-delete-form" method="POST" action="" style="display:none">
          <input type="hidden" name="_token" id="single-delete-token" value="">
          <input type="hidden" name="_method" value="POST">
        </form>

        {# Formulaire flush individuel #}
        <form id="single-flush-form" method="POST" action="" style="display:none">
          <input type="hidden" name="_token" id="single-flush-token" value="">
        </form>

        {# Formulaire bulk delete #}
        <form id="bulk-delete-form" method="POST" action="{{ path('admin_meilisearch_index_bulk_delete') }}" style="display:none">
          <input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_indexes') }}">
        </form>

        {# Formulaire bulk flush #}
        <form id="bulk-flush-form" method="POST" action="{{ path('admin_meilisearch_index_bulk_flush') }}" style="display:none">
          <input type="hidden" name="_token" value="{{ csrf_token('bulk_flush_indexes') }}">
        </form>

        {# Formulaire bulk reindex #}
        <form id="bulk-reindex-form" method="POST" action="{{ path('admin_meilisearch_index_bulk_reindex') }}" style="display:none">
          <input type="hidden" name="_token" value="{{ csrf_token('bulk_reindex_indexes') }}">
        </form>

        {# Formulaire réindexation individuelle #}
        <form id="single-reindex-form" method="POST" action="" style="display:none">
          <input type="hidden" name="_token" id="single-reindex-token" value="">
        </form>

        <div class="d-flex align-items-center mb-2 px-1">
          <select class="form-control form-control-sm w-auto mr-2" id="bulk-action-select">
            <option value="">{{ bulkActionsPlaceholder }}</option>
            <option value="reindex">{{ bulkReindexLabel }}</option>
            <option value="flush">{{ bulkFlushLabel }}</option>
            <option value="delete">{{ bulkDeleteLabel }}</option>
          </select>
          <button type="button" class="btn btn-sm btn-outline-danger" id="bulk-action-apply">{{ applyLabel }}</button>
        </div>

        <table class="table mb-0">
          <thead>
            <tr>
              <th style="width:40px"><input type="checkbox" id="select-all"></th>
              <th>UID</th>
              <th>Documents</th>
              <th>{{ colCreatedAt }}</th>
              <th>{{ colUpdatedAt }}</th>
              <th>{{ colActions }}</th>
            </tr>
          </thead>
          <tbody>
            {% for index in indexes %}
            <tr>
              <td><input type="checkbox" name="uids[]" value="{{ index.uid }}" class="row-checkbox" form="bulk-delete-form"></td>
              <td>{{ index.uid }}</td>
              <td>{{ index.numberOfDocuments ?? '—' }}</td>
              <td>{{ index.createdAt ? index.createdAt|slice(0, 19)|replace({'T': ' '}) : '—' }}</td>
              <td>{{ index.updatedAt ? index.updatedAt|slice(0, 19)|replace({'T': ' '}) : '—' }}</td>
              <td>
                <a href="{{ path('admin_meilisearch_index_settings', {uid: index.uid}) }}" class="btn btn-sm btn-outline-secondary">{{ btnEdit }}</a>
                <button type="button" class="btn btn-sm btn-outline-primary"
                  data-action="{{ path('admin_meilisearch_index_reindex_language', {uid: index.uid}) }}"
                  data-token="{{ csrf_token('reindex_index_' ~ index.uid) }}"
                  data-uid="{{ index.uid }}"
                  onclick="confirmReindex(this)">{{ btnReindex }}</button>
                <button type="button" class="btn btn-sm btn-outline-warning"
                  data-action="{{ path('admin_meilisearch_index_flush', {uid: index.uid}) }}"
                  data-token="{{ csrf_token('flush_index_' ~ index.uid) }}"
                  data-uid="{{ index.uid }}"
                  onclick="confirmFlush(this)">{{ btnFlush }}</button>
                <button type="button" class="btn btn-sm btn-outline-danger"
                  data-action="{{ path('admin_meilisearch_index_delete', {uid: index.uid}) }}"
                  data-token="{{ csrf_token('delete_index_' ~ index.uid) }}"
                  data-uid="{{ index.uid }}"
                  onclick="confirmDelete(this)">{{ btnDelete }}</button>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>

        <script>
          function confirmReindex(btn) {
            if (!confirm(msI18n.confirmReindex.replace('%s', btn.dataset.uid))) return;
            var form = document.getElementById('single-reindex-form');
            form.action = btn.dataset.action;
            document.getElementById('single-reindex-token').value = btn.dataset.token;
            form.submit();
          }

          function confirmFlush(btn) {
            if (!confirm(msI18n.confirmFlush.replace('%s', btn.dataset.uid))) return;
            var form = document.getElementById('single-flush-form');
            form.action = btn.dataset.action;
            document.getElementById('single-flush-token').value = btn.dataset.token;
            form.submit();
          }

          function confirmDelete(btn) {
            if (!confirm(msI18n.confirmDelete.replace('%s', btn.dataset.uid))) return;
            var form = document.getElementById('single-delete-form');
            form.action = btn.dataset.action;
            document.getElementById('single-delete-token').value = btn.dataset.token;
            form.submit();
          }

          document.getElementById('select-all').addEventListener('change', function () {
            document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
          });

          document.getElementById('bulk-action-apply').addEventListener('click', function () {
            var action = document.getElementById('bulk-action-select').value;
            var checked = document.querySelectorAll('.row-checkbox:checked');
            if (!action || !checked.length) return;

            var messages = {
              reindex: msI18n.confirmBulkReindex.replace('%d', checked.length),
              flush: msI18n.confirmBulkFlush.replace('%d', checked.length),
              delete: msI18n.confirmBulkDelete.replace('%d', checked.length)
            };
            var forms = { reindex: 'bulk-reindex-form', flush: 'bulk-flush-form', delete: 'bulk-delete-form' };

            if (confirm(messages[action])) {
              var form = document.getElementById(forms[action]);
              checked.forEach(function (cb) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'uids[]';
                input.value = cb.value;
                form.appendChild(input);
              });
              form.submit();
            }
          });
        </script>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.getElementById('reindex-lang-btn').addEventListener('click', function () {
    var select = document.getElementById('reindex-lang-select');
    var opt = select.options[select.selectedIndex];
    if (!opt.value) { alert(msI18n.pleaseChooseLang); return; }
    if (!confirm(msI18n.confirmReindexLang.replace('%s', opt.text))) return;
    var form = document.getElementById('reindex-lang-form');
    form.action = opt.dataset.action;
    document.getElementById('reindex-lang-token').value = opt.dataset.token;
    form.submit();
  });
</script>
{% endblock %}
