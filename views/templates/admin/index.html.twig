{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  <div class="card">
    <div class="card-header">
      <h3>Indexation Meilisearch</h3>
    </div>
    <div class="card-body">
      <form method="POST" action="{{ path('admin_meilisearchconfiguration_index_products') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('index_products') }}">
        <button type="submit" class="btn btn-primary">
          Indexer les produits dans Meilisearch
        </button>
      </form>
    </div>
  </div>
{% endblock %}
