# Config de base pour l'action PrestaShop (paramètres uniquement, pas d'includes).
# Pas de bootstrapFiles : ps-module-extension fournit le bootstrap PrestaShop.
# Nos stubs (phpstan-stubs.php) ne doivent pas être chargés en CI (PrestaShop réel = conflit "class already in use").
parameters:
  paths:
    - ../../../upgrade
    - ../../../classes
  scanFiles:
    - ../../../meilisearchprestashop.php
  reportUnmatchedIgnoredErrors: false
  level: 5
  ignoreErrors:
    # Cookie dynamic properties used for Meilisearch session tracking
    - '#^Access to an undefined property Cookie\:\:\$meilisearch_id\.$#'
    - '#^Access to an undefined property Cookie\:\:\$meilisearch_query\.$#'
    - '#^Access to an undefined property Cookie\:\:\$meilisearch_product_id\.$#'
    # requestCurl() is defined on the concrete Meilisearchprestashop class, not on Module base class
    - '#^Call to an undefined method Module\:\:requestCurl\(\)\.$#'
    # setNextEncodedFacets() accepts string at runtime; PS stub incorrectly declares array
    - '#^Parameter \#1 \$nextEncodedFacets of method PrestaShop\\\\PrestaShop\\\\Core\\\\Product\\\\Search\\\\Filter\:\:setNextEncodedFacets\(\) expects array, string given\.$#'
    # $response is a stdClass from json_decode(); object shape types not supported in PS 1.7 PHPStan
    - '#^Access to an undefined property object\:\:\$estimatedTotalHits\.$#'
    - '#^Access to an undefined property object\:\:\$hits\.$#'
    # Defensive null checks on Meilisearch API response
    - '#^Negated boolean expression is always false\.$#'
    - '#^Ternary operator condition is always true\.$#'
